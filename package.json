{
  "name": "start2code",
  "version": "1.0.0",
  "description": "Official leaderboard for the Start2Code Open Source Contribution Marathon — GitHub Club, Technova, SSCSE, Sharda University",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "css:build": "npx tailwindcss -i public/css/input.css -o public/css/output.css --minify",
    "css:watch": "npx tailwindcss -i public/css/input.css -o public/css/output.css --watch",
    "seed:rules": "node scripts/seedPointRules.js",
    "setup:admin": "node scripts/setupAdmin.js",
    "backfill": "node scripts/backfillPRs.js"
  },
  "keywords": [
    "leaderboard",
    "github",
    "open-source",
    "firebase",
    "start2code"
  ],
  "author": "GitHub Club, Technova — SSCSE, Sharda University",
  "license": "MIT",
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@octokit/rest": "^21.1.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.0.3",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
