<%- include('partials/header') %>

<main class="flex-1 flex items-center justify-center py-20">
  <div class="container-narrow text-center max-w-lg">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-rose-500/10 text-rose-500 mb-6 border border-rose-500/20">
      <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>
    <div class="font-mono text-5xl font-extrabold text-surface-900 dark:text-white mb-3">
      <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
    </div>
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white mb-2">
      <%= typeof title !== 'undefined' ? title : 'An Error Occurred' %>
    </h1>
    <p class="text-surface-500 dark:text-surface-400 mb-8 leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong. Please check back later or return to the leaderboard.' %>
    </p>
    <div class="flex items-center justify-center gap-4">
      <a href="/" class="btn-primary">
        <svg class="w-4 h-4 mr-2 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Back to Home
      </a>
      <a href="/contributors" class="btn-secondary">
        View Leaderboard
      </a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
