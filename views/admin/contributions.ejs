<%- include('../partials/header') %>
<%- include('../partials/admin-nav', { activeTab: 'contributions' }) %>

<main class="flex-1 pb-16">
  <div class="container-narrow">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="section-title">Manage Contributions</h1>
        <p class="section-subtitle">Review, approve, reject, adjust, or resync pull requests</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <select id="status-filter" class="input-field text-sm w-40">
          <option value="all">All Statuses</option>
          <option value="awarded">Awarded</option>
          <option value="pending-approval">Pending Approval</option>
          <option value="rejected">Rejected</option>
        </select>
        <div class="relative w-64">
          <input type="text" id="contribution-search" placeholder="Search by PR or user..." class="input-field pl-9 text-sm">
          <svg class="w-4 h-4 text-surface-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
      </div>
    </div>

    <div class="glass-card overflow-hidden">
      <% if (contributions && contributions.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm" id="contributions-table">
          <thead>
            <tr class="border-b border-surface-200 dark:border-surface-700 text-xs text-surface-400 uppercase bg-surface-100/50 dark:bg-surface-800/50">
              <th class="py-3 px-4 w-20">PR</th>
              <th class="py-3 px-4">Title &amp; Contributor</th>
              <th class="py-3 px-4">Labels &amp; Breakdown</th>
              <th class="py-3 px-4 text-center w-24">Points</th>
              <th class="py-3 px-4 text-center w-32">Status</th>
              <th class="py-3 px-4 text-right">Merged At</th>
              <th class="py-3 px-4 text-right w-48">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-100 dark:divide-surface-800">
            <% contributions.forEach(function(c) { %>
            <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/40 transition-colors contribution-row"
                data-status="<%= c.status %>"
                data-search="<%= (c.prNumber + ' ' + c.prTitle + ' ' + c.githubUsername).toLowerCase() %>">
              <td class="py-3 px-4 font-mono font-bold">
                <a href="<%= c.prUrl %>" target="_blank" rel="noopener" class="text-brand-600 dark:text-brand-400 hover:underline">
                  #<%= c.prNumber %>
                </a>
              </td>
              <td class="py-3 px-4">
                <div class="font-semibold text-surface-900 dark:text-white line-clamp-1"><%= c.prTitle %></div>
                <div class="text-xs text-surface-400 mt-0.5">
                  by <a href="/contributor/<%= c.githubUsername %>" class="hover:underline text-surface-600 dark:text-surface-300">@<%= c.githubUsername %></a>
                </div>
              </td>
              <td class="py-3 px-4">
                <div class="flex flex-wrap gap-1 max-w-xs">
                  <% if (c.labels && c.labels.length > 0) { %>
                    <% c.labels.forEach(function(l) { %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800">
                        <%= l.name %> <span class="font-bold text-emerald-600 dark:text-emerald-400">+<%= l.points %></span>
                      </span>
                    <% }); %>
                  <% } else { %>
                    <span class="text-xs text-surface-400 italic">No point labels</span>
                  <% } %>
                </div>
              </td>
              <td class="py-3 px-4 text-center font-bold text-lg text-surface-900 dark:text-white">
                <%= c.totalPoints %>
              </td>
              <td class="py-3 px-4 text-center">
                <% if (c.status === 'awarded') { %>
                  <span class="badge badge-success text-xs">Awarded</span>
                <% } else if (c.status === 'pending-approval') { %>
                  <span class="badge badge-warning text-xs">Pending Approval</span>
                <% } else { %>
                  <span class="badge badge-danger text-xs"><%= c.status %></span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-right text-xs text-surface-400">
                <%= c.mergedAt ? (typeof formatRelativeTime === 'function' ? formatRelativeTime(c.mergedAt) : c.mergedAt) : '—' %>
              </td>
              <td class="py-3 px-4 text-right space-x-1 whitespace-nowrap">
                <% if (c.status !== 'awarded') { %>
                  <button onclick="approveContribution('<%= c.id %>')" class="px-2 py-1 text-xs font-semibold rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/20" title="Approve">
                    Approve
                  </button>
                <% } %>
                <% if (c.status !== 'rejected') { %>
                  <button onclick="rejectContribution('<%= c.id %>')" class="px-2 py-1 text-xs font-semibold rounded bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-500/20" title="Reject">
                    Reject
                  </button>
                <% } %>
                <button onclick="openAdjustModal('<%= c.id %>', <%= c.totalPoints %>, '<%= c.githubUsername %>')" class="px-2 py-1 text-xs font-semibold rounded bg-surface-200 dark:bg-surface-700 text-surface-700 dark:text-surface-200 hover:bg-surface-300" title="Adjust Points">
                  Adjust
                </button>
                <button onclick="resyncSinglePR(<%= c.prNumber %>)" class="px-2 py-1 text-xs font-semibold rounded bg-brand-500/10 text-brand-600 dark:text-brand-400 hover:bg-brand-500/20" title="Resync from GitHub">
                  Resync
                </button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-12">
        <svg class="w-12 h-12 mx-auto text-surface-300 dark:text-surface-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p class="text-surface-400">No contributions recorded yet.</p>
      </div>
      <% } %>
    </div>
  </div>
</main>

<!-- Adjust Points Modal -->
<div id="adjust-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
  <div class="glass-card p-6 max-w-md w-full mx-4 shadow-2xl">
    <h3 class="text-lg font-bold text-surface-900 dark:text-white mb-1">Manual Point Adjustment</h3>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4" id="adjust-modal-sub">Adjust points for contributor</p>
    <input type="hidden" id="adjust-contrib-id">
    <div class="space-y-4 mb-6">
      <div>
        <label class="block text-xs font-semibold text-surface-700 dark:text-surface-300 mb-1">Adjustment (Delta Points)</label>
        <input type="number" id="adjust-points-input" placeholder="e.g. 5 or -5" class="input-field font-mono" required>
        <p class="text-xs text-surface-400 mt-1">Use positive numbers to add points, negative to subtract.</p>
      </div>
      <div>
        <label class="block text-xs font-semibold text-surface-700 dark:text-surface-300 mb-1">Reason for Audit Log</label>
        <input type="text" id="adjust-reason-input" placeholder="e.g. Bonus for documentation quality" class="input-field" required>
      </div>
    </div>
    <div class="flex justify-end gap-2">
      <button onclick="closeAdjustModal()" class="btn-secondary text-sm">Cancel</button>
      <button onclick="submitAdjustment()" id="submit-adjust-btn" class="btn-primary text-sm">Apply Adjustment</button>
    </div>
  </div>
</div>

<script>
  // Filter by status & search
  const statusFilter = document.getElementById('status-filter');
  const searchInput = document.getElementById('contribution-search');

  function applyFilters() {
    const status = statusFilter.value;
    const query = searchInput.value.toLowerCase().trim();

    document.querySelectorAll('.contribution-row').forEach(row => {
      const matchStatus = (status === 'all' || row.dataset.status === status);
      const matchSearch = (!query || row.dataset.search.includes(query));
      row.style.display = (matchStatus && matchSearch) ? '' : 'none';
    });
  }

  statusFilter?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);
</script>
<script src="/js/admin.js"></script>

<%- include('../partials/footer') %>
