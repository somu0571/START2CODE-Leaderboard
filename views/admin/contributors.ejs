<%- include('../partials/header') %>
<%- include('../partials/admin-nav', { activeTab: 'contributors' }) %>

<main class="flex-1 pb-16">
  <div class="container-narrow">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="section-title">Manage Contributors</h1>
        <p class="section-subtitle">Overview of all active contributors, scores, and activity</p>
      </div>
      <div>
        <div class="relative w-72">
          <input type="text" id="contributor-filter" placeholder="Filter contributors..." class="input-field pl-9 text-sm">
          <svg class="w-4 h-4 text-surface-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
      </div>
    </div>

    <div class="glass-card overflow-hidden">
      <% if (contributors && contributors.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm" id="contributors-table">
          <thead>
            <tr class="border-b border-surface-200 dark:border-surface-700 text-xs text-surface-400 uppercase bg-surface-100/50 dark:bg-surface-800/50">
              <th class="py-3 px-4 text-center w-16">Rank</th>
              <th class="py-3 px-4">Contributor</th>
              <th class="py-3 px-4 text-right">Points</th>
              <th class="py-3 px-4 text-right">Merged PRs</th>
              <th class="py-3 px-4 text-right">Manual Adj</th>
              <th class="py-3 px-4 text-right">Last Contribution</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-100 dark:divide-surface-800">
            <% contributors.forEach(function(c) { %>
            <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/40 transition-colors contributor-row" data-name="<%= (c.githubUsername + ' ' + (c.displayName || '')).toLowerCase() %>">
              <td class="py-3 px-4 text-center font-mono font-bold">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-surface-200 dark:bg-surface-700 text-surface-700 dark:text-surface-200 text-xs">
                  <%= c.rank %>
                </span>
              </td>
              <td class="py-3 px-4">
                <div class="flex items-center gap-3">
                  <img src="<%= c.avatarUrl %>" alt="" class="w-8 h-8 rounded-full ring-1 ring-surface-200 dark:ring-surface-700" loading="lazy">
                  <div>
                    <div class="font-semibold text-surface-900 dark:text-white"><%= c.displayName || c.githubUsername %></div>
                    <div class="text-xs text-surface-400 font-mono">@<%= c.githubUsername %> &bull; ID: <%= c.githubId %></div>
                  </div>
                </div>
              </td>
              <td class="py-3 px-4 text-right font-bold text-brand-600 dark:text-brand-400">
                <%= c.totalPoints %>
              </td>
              <td class="py-3 px-4 text-right font-medium text-surface-700 dark:text-surface-300">
                <%= c.mergedPRs %>
              </td>
              <td class="py-3 px-4 text-right font-mono text-xs">
                <% if (c.manualAdjustment > 0) { %>
                  <span class="text-emerald-500 font-bold">+<%= c.manualAdjustment %></span>
                <% } else if (c.manualAdjustment < 0) { %>
                  <span class="text-rose-500 font-bold"><%= c.manualAdjustment %></span>
                <% } else { %>
                  <span class="text-surface-400">0</span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-right text-xs text-surface-400">
                <%= c.lastContributionAt ? (typeof formatRelativeTime === 'function' ? formatRelativeTime(c.lastContributionAt) : c.lastContributionAt) : '—' %>
              </td>
              <td class="py-3 px-4 text-right space-x-2">
                <a href="/contributor/<%= c.githubUsername %>" target="_blank" class="btn-ghost text-xs px-2.5 py-1">
                  Public Profile
                </a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-12">
        <svg class="w-12 h-12 mx-auto text-surface-300 dark:text-surface-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <p class="text-surface-400">No contributors found yet.</p>
      </div>
      <% } %>
    </div>
  </div>
</main>

<script>
  document.getElementById('contributor-filter')?.addEventListener('input', function(e) {
    const q = e.target.value.toLowerCase();
    document.querySelectorAll('.contributor-row').forEach(row => {
      row.style.display = row.dataset.name.includes(q) ? '' : 'none';
    });
  });
</script>
<script src="/js/admin.js"></script>

<%- include('../partials/footer') %>
