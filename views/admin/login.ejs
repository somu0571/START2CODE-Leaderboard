<%- include('../partials/header') %>

  <main class="flex-1 flex items-center justify-center py-16">
    <div class="w-full max-w-md px-4">
      <div class="glass-card p-8 shadow-2xl border border-surface-200/80 dark:border-surface-800/80">
        <div class="text-center mb-8">
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-brand-600/10 text-brand-600 mb-4 ring-1 ring-brand-500/20">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
          <h1 class="text-2xl font-extrabold text-surface-900 dark:text-white">Admin Authentication</h1>
          <p class="text-sm text-surface-500 dark:text-surface-400 mt-1">Sign in with authorized Firebase credentials
          </p>
        </div>

        <% var hasApiKey=(typeof firebaseConfig !=='undefined' && firebaseConfig && firebaseConfig.apiKey); %>
          <% if (!hasApiKey) { %>
            <div
              class="mb-6 p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 text-xs flex items-start gap-2.5">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              <div>
                <span class="font-bold">Firebase Web Config Missing:</span>
                Please set <code class="font-mono bg-amber-500/20 px-1 py-0.5 rounded">FIREBASE_API_KEY</code> and <code
                  class="font-mono bg-amber-500/20 px-1 py-0.5 rounded">FIREBASE_PROJECT_ID</code> in your <code
                  class="font-mono bg-amber-500/20 px-1 py-0.5 rounded">.env</code> file.
              </div>
            </div>
            <% } %>

              <div id="login-error"
                class="hidden mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="8" x2="12" y2="12" />
                  <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <span id="login-error-text">Authentication failed</span>
              </div>

              <form id="admin-login-form" class="space-y-4" method="POST" action="javascript:void(0)">
                <div>
                  <label for="email"
                    class="block text-sm font-semibold text-surface-700 dark:text-surface-300 mb-1.5">Email
                    Address</label>
                  <div class="relative">
                    <input type="email" id="email" required class="input-field pl-10" placeholder="admin@example.com"
                      autocomplete="username">
                    <svg class="w-5 h-5 text-surface-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                  </div>
                </div>

                <div>
                  <label for="password"
                    class="block text-sm font-semibold text-surface-700 dark:text-surface-300 mb-1.5">Password</label>
                  <div class="relative">
                    <input type="password" id="password" required class="input-field pl-10" placeholder="••••••••••••"
                      autocomplete="current-password">
                    <svg class="w-5 h-5 text-surface-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                  </div>
                </div>

                <button type="submit" id="login-btn"
                  class="btn-primary w-full py-2.5 flex items-center justify-center gap-2 mt-6">
                  <span id="login-btn-text">Sign In to Admin Portal</span>
                  <svg id="login-spinner" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" viewBox="0 0 24 24"
                    fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                  </svg>
                </button>
              </form>

              <div class="mt-6 pt-6 border-t border-surface-200 dark:border-surface-800 text-center">
                <p class="text-xs text-surface-400">
                  Access restricted to event organizers and leads.<br>
                  Run <code class="font-mono text-brand-600 dark:text-brand-400">node scripts/setupAdmin.js</code> to
                  initialize admin privileges.
                </p>
              </div>
      </div>
    </div>
  </main>

  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>

  <script>
    window.__FIREBASE_CONFIG__ = <% - JSON.stringify(typeof firebaseConfig !== 'undefined' && firebaseConfig ? firebaseConfig : {}) %>;
  </script>
  <script src="/js/admin.js"></script>

  <%- include('../partials/footer') %>