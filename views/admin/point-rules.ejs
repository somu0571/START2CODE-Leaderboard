<%- include('../partials/header') %>
<%- include('../partials/admin-nav', { activeTab: 'rules' }) %>

<main class="flex-1 pb-16">
  <div class="container-narrow">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="section-title">Point Rules Configuration</h1>
        <p class="section-subtitle">Manage point values, active status, and descriptions for GitHub labels</p>
      </div>
      <button onclick="openRuleModal()" class="btn-primary text-sm flex items-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New / Edit Rule
      </button>
    </div>

    <!-- Alert explaining scoring logic -->
    <div class="glass-card p-4 mb-8 border-l-4 border-l-brand-500 flex items-start gap-3 text-sm">
      <svg class="w-5 h-5 text-brand-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <div>
        <span class="font-bold text-surface-900 dark:text-white">Scoring Engine Rules:</span>
        Contributions receive <strong class="text-brand-600 dark:text-brand-400">NO base points</strong>. Points are calculated purely from matching active labels. If multiple S2C tier labels are attached to a single PR, only the <strong class="text-brand-600 dark:text-brand-400">highest S2C tier</strong> is awarded.
      </div>
    </div>

    <div class="glass-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-surface-200 dark:border-surface-700 text-xs text-surface-400 uppercase bg-surface-100/50 dark:bg-surface-800/50">
              <th class="py-3 px-4">Label Name</th>
              <th class="py-3 px-4">Category</th>
              <th class="py-3 px-4 text-center">Points</th>
              <th class="py-3 px-4">Description</th>
              <th class="py-3 px-4 text-center">Status</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-100 dark:divide-surface-800">
            <% Object.entries(rules || {}).forEach(function([labelKey, r]) { %>
            <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/40 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-surface-900 dark:text-white">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-surface-200 dark:bg-surface-700">
                  <%= labelKey %>
                </span>
              </td>
              <td class="py-3 px-4 text-xs font-medium">
                <% if (labelKey.startsWith('s2c-tier-')) { %>
                  <span class="text-purple-500 font-bold">S2C Tier</span>
                <% } else { %>
                  <span class="text-surface-500 dark:text-surface-400">Regular</span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-center font-bold text-base text-brand-600 dark:text-brand-400">
                <%= r.points %>
              </td>
              <td class="py-3 px-4 text-xs text-surface-600 dark:text-surface-300 max-w-sm">
                <%= r.description || '—' %>
              </td>
              <td class="py-3 px-4 text-center">
                <% if (r.active !== false) { %>
                  <span class="badge badge-success text-xs">Active</span>
                <% } else { %>
                  <span class="badge badge-danger text-xs">Inactive</span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-right">
                <button onclick="editRule('<%= labelKey %>', <%= r.points %>, '<%= (r.description || '').replace(/'/g, '\\\'') %>', <%= r.active !== false %>)" class="btn-ghost text-xs px-2.5 py-1">
                  Edit
                </button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- Edit Rule Modal -->
<div id="rule-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
  <div class="glass-card p-6 max-w-md w-full mx-4 shadow-2xl">
    <h3 class="text-lg font-bold text-surface-900 dark:text-white mb-2" id="rule-modal-title">Configure Point Rule</h3>
    <form id="point-rule-form" onsubmit="submitRuleForm(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-surface-700 dark:text-surface-300 mb-1">GitHub Label (Case-Insensitive)</label>
        <input type="text" id="rule-label-input" placeholder="e.g. s2c-tier-1 or bug" class="input-field font-mono" required>
      </div>
      <div>
        <label class="block text-xs font-semibold text-surface-700 dark:text-surface-300 mb-1">Points</label>
        <input type="number" id="rule-points-input" placeholder="e.g. 50" class="input-field font-mono" min="0" required>
      </div>
      <div>
        <label class="block text-xs font-semibold text-surface-700 dark:text-surface-300 mb-1">Description</label>
        <input type="text" id="rule-description-input" placeholder="e.g. Major feature or complex architectural work" class="input-field">
      </div>
      <div class="flex items-center gap-2 pt-1">
        <input type="checkbox" id="rule-active-input" checked class="w-4 h-4 rounded text-brand-600">
        <label for="rule-active-input" class="text-xs font-semibold text-surface-700 dark:text-surface-300 cursor-pointer">Active in Scoring Engine</label>
      </div>
      <div class="flex justify-end gap-2 pt-4 border-t border-surface-200 dark:border-surface-700">
        <button type="button" onclick="closeRuleModal()" class="btn-secondary text-sm">Cancel</button>
        <button type="submit" id="save-rule-btn" class="btn-primary text-sm">Save Rule</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/admin.js"></script>

<%- include('../partials/footer') %>
