<%- include('partials/header') %>

<% 
  var repoUrl = (typeof repo !== 'undefined' && repo && repo.url) ? repo.url : 'https://github.com/somu0571/InternPilot';
  var eventTagline = (typeof event !== 'undefined' && event && event.tagline) ? event.tagline : 'Learn Git. Ship Code. Contribute to Open Source.';
%>

<main class="flex-1">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600/5 via-purple-600/5 to-pink-600/5 dark:from-brand-600/10 dark:via-purple-600/10 dark:to-pink-600/10"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-to-b from-brand-500/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
    <div class="container-narrow relative py-16 md:py-24 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-brand-100 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 rounded-full text-sm font-medium mb-6 animate-fade-in">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        GitHub Club &middot; Technova &middot; SSCSE &middot; Sharda University
      </div>

      <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-4 animate-slide-up">
        <span class="gradient-text">START2CODE</span>
      </h1>
      <p class="text-xl md:text-2xl font-semibold text-surface-700 dark:text-surface-200 mb-2 animate-slide-up">
        Git, GitHub &amp; Open Source Bootcamp
      </p>
      <p class="text-lg text-surface-500 dark:text-surface-400 max-w-xl mx-auto mb-8 animate-slide-up">
        <%= eventTagline %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8 animate-slide-up">
        <a href="<%= repoUrl %>" target="_blank" rel="noopener" class="btn-primary">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          View Repository
        </a>
        <a href="<%= repoUrl %>/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener" class="btn-secondary">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          Good First Issues
        </a>
      </div>

      <div class="inline-flex items-center gap-4 text-sm text-surface-400 animate-fade-in">
        <span>19 Sep &ndash; 27 Sep 2026</span>
        <span class="w-1 h-1 rounded-full bg-surface-400"></span>
        <span>Online Marathon</span>
        <span class="w-1 h-1 rounded-full bg-surface-400"></span>
        <span id="countdown-text" class="font-mono font-semibold text-brand-500"></span>
      </div>
    </div>
  </section>

  <%- include('partials/event-banner', { 
    event: typeof event !== 'undefined' ? event : {}, 
    daysRemaining: typeof daysRemaining !== 'undefined' ? daysRemaining : null 
  }) %>

  <!-- Live Statistics -->
  <section class="py-12">
    <div class="container-narrow">
      <div class="text-center mb-8">
        <h2 class="section-title">Live Statistics</h2>
        <p class="section-subtitle mx-auto">Real-time contribution tracking from the marathon</p>
      </div>
      <%- include('partials/stats-card', { 
        stats: typeof stats !== 'undefined' ? stats : null, 
        repoInfo: typeof repoInfo !== 'undefined' ? repoInfo : null, 
        currentDay: typeof currentDay !== 'undefined' ? currentDay : 1 
      }) %>
    </div>
  </section>

  <!-- Top Contributors Podium -->
  <% if (typeof topContributors !== 'undefined' && topContributors && topContributors.length > 0) { %>
  <section class="py-12 bg-gradient-to-b from-transparent via-brand-50/30 dark:via-brand-950/20 to-transparent">
    <div class="container-narrow">
      <div class="text-center mb-10">
        <h2 class="section-title">Top Contributors</h2>
        <p class="section-subtitle mx-auto">Leading the Start2Code marathon</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <% var order = topContributors.length >= 3 ? [1, 0, 2] : topContributors.map((_, i) => i); %>
        <% order.forEach(function(idx) { %>
          <% if (idx < topContributors.length) { var c = topContributors[idx]; %>
          <div class="podium-card <%= idx === 0 ? 'md:scale-110 md:-translate-y-4 ring-2 ring-amber-400/50' : '' %> animate-slide-up">
            <% if (idx === 0) { %>
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-400"></div>
            <% } else if (idx === 1) { %>
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-surface-400 via-surface-300 to-surface-400"></div>
            <% } else { %>
              <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-orange-400 via-amber-500 to-orange-400"></div>
            <% } %>
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-full font-bold text-lg mb-3 <%= idx === 0 ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' : idx === 1 ? 'bg-surface-200 text-surface-600 dark:bg-surface-700 dark:text-surface-300' : 'bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300' %>">
              <%= c.rank %>
            </div>
            <a href="/contributor/<%= c.githubUsername %>">
              <img src="<%= c.avatarUrl || ('https://github.com/' + c.githubUsername + '.png') %>" alt="" class="w-16 h-16 rounded-full mx-auto ring-4 <%= idx === 0 ? 'ring-amber-300 dark:ring-amber-600' : idx === 1 ? 'ring-surface-300 dark:ring-surface-600' : 'ring-orange-300 dark:ring-orange-600' %> mb-3" loading="lazy">
            </a>
            <a href="/contributor/<%= c.githubUsername %>" class="font-bold text-surface-900 dark:text-white hover:text-brand-600 transition-colors block"><%= c.displayName || c.githubUsername %></a>
            <div class="text-xs text-surface-400 mb-2">@<%= c.githubUsername %></div>
            <div class="text-2xl font-black gradient-text"><%= c.totalPoints %></div>
            <div class="text-xs text-surface-400 mt-1"><%= c.mergedPRs %> merged PR<%= c.mergedPRs !== 1 ? 's' : '' %></div>
          </div>
          <% } %>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Leaderboard Preview -->
  <section class="py-12">
    <div class="container-narrow">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="section-title">Leaderboard</h2>
          <p class="section-subtitle">Ranked by contribution points</p>
        </div>
        <a href="/contributors" class="btn-secondary text-sm">
          View All
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
      <div class="glass-card overflow-hidden">
        <%- include('partials/leaderboard-table', { 
          leaderboard: typeof leaderboard !== 'undefined' ? leaderboard : null, 
          formatRelativeTime: typeof formatRelativeTime === 'function' ? formatRelativeTime : null 
        }) %>
      </div>
    </div>
  </section>

  <!-- Repository Card -->
  <section class="py-12 bg-gradient-to-b from-transparent via-surface-100/50 dark:via-surface-900/50 to-transparent">
    <div class="container-narrow">
      <div class="text-center mb-8">
        <h2 class="section-title">The Project</h2>
        <p class="section-subtitle mx-auto">Contribute to InternPilot &mdash; an AI-powered internship management platform</p>
      </div>
      <%- include('partials/repo-card', { 
        repoInfo: typeof repoInfo !== 'undefined' ? repoInfo : null,
        repo: typeof repo !== 'undefined' ? repo : null
      }) %>
    </div>
  </section>

  <!-- Open Issues -->
  <% if (typeof issues !== 'undefined' && issues && issues.length > 0) { %>
  <section class="py-12">
    <div class="container-narrow">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="section-title">Open Issues</h2>
          <p class="section-subtitle">Find something to work on</p>
        </div>
        <a href="<%= repoUrl %>/issues" target="_blank" rel="noopener" class="btn-secondary text-sm">
          All Issues
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% issues.forEach(function(issue) { %>
        <a href="<%= issue.htmlUrl %>" target="_blank" rel="noopener" class="glass-card-hover p-5 block">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div class="min-w-0 flex-1">
              <h4 class="font-semibold text-sm text-surface-900 dark:text-white truncate">#<%= issue.number %> &mdash; <%= issue.title %></h4>
              <div class="flex flex-wrap gap-1.5 mt-2">
                <% (issue.labels || []).forEach(function(label) { 
                    var name = typeof label === 'string' ? label : (label.name || '');
                    var hex = typeof label === 'object' && label.color ? String(label.color).replace(/^#/, '') : '6366f1';
                    if (!/^[0-9a-fA-F]{3,8}$/.test(hex)) hex = '6366f1';
                %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border"
                      style="background-color: #<%= hex %>15; border-color: #<%= hex %>40; color: #<%= hex %>;">
                  #<%= name %>
                </span>
                <% }); %>
              </div>
            </div>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Contribution Flow -->
  <section class="py-12 bg-gradient-to-b from-transparent via-brand-50/30 dark:via-brand-950/20 to-transparent">
    <div class="container-narrow">
      <div class="text-center mb-10">
        <h2 class="section-title">How to Contribute</h2>
        <p class="section-subtitle mx-auto">From fork to points in 8 steps</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3">
        <% var steps = [
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><line x1="12" y1="12" x2="12" y2="15"/></svg>', label: 'Fork' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>', label: 'Branch' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>', label: 'Commit' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>', label: 'Push' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" y1="9" x2="6" y2="21"/></svg>', label: 'PR' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>', label: 'Review' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>', label: 'Merge' },
          { icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>', label: 'Points' }
        ]; %>
        <% steps.forEach(function(step, i) { %>
        <div class="glass-card p-4 text-center animate-slide-up" style="animation-delay: <%= i * 80 %>ms">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-50 dark:bg-brand-900/20 text-brand-600 dark:text-brand-400 mb-2">
            <%- step.icon %>
          </div>
          <div class="text-xs font-semibold text-surface-600 dark:text-surface-300"><%= step.label %></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<script src="/js/countdown.js"></script>

<%- include('partials/footer') %>
