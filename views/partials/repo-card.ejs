<% 
  var info = (typeof repoInfo !== 'undefined' && repoInfo) ? repoInfo : null;
  var repoName = (info && info.fullName) ? info.fullName : 'somu0571/InternPilot';
  var repoDesc = (info && info.description) ? info.description : (typeof repo !== 'undefined' && repo && repo.description ? repo.description : 'AI-powered full-stack internship portal connecting students and companies.');
  var repoLink = (info && info.htmlUrl) ? info.htmlUrl : (typeof repo !== 'undefined' && repo && repo.url ? repo.url : 'https://github.com/somu0571/InternPilot');
  var stars = (info && info.stars) ? info.stars : 0;
  var forks = (info && info.forks) ? info.forks : 0;
  var watchers = (info && info.watchers) ? info.watchers : 0;
  var issues = (info && info.openIssues) ? info.openIssues : 0;
%>

<div class="glass-card p-6 shadow-xl border border-surface-200/80 dark:border-surface-800/80">
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 mb-2">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        Target Marathon Repository
      </div>
      <h3 class="font-bold text-xl text-surface-900 dark:text-white">
        <a href="<%= repoLink %>" target="_blank" rel="noopener" class="hover:text-brand-600 transition-colors inline-flex items-center gap-2">
          <%= repoName %>
          <svg class="w-4 h-4 text-surface-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </h3>
      <p class="text-sm text-surface-500 dark:text-surface-400 mt-1 max-w-2xl leading-relaxed"><%= repoDesc %></p>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <a href="<%= repoLink %>" target="_blank" rel="noopener" class="btn-primary text-xs px-3.5 py-2">
        Star on GitHub
      </a>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-surface-200/60 dark:border-surface-700/60">
    <div class="text-center p-3 rounded-xl bg-surface-100/40 dark:bg-surface-800/40">
      <div class="flex items-center justify-center gap-1.5 text-amber-500 mb-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span class="font-bold text-base"><%= stars %></span>
      </div>
      <span class="text-xs text-surface-400 font-medium">Stars</span>
    </div>
    <div class="text-center p-3 rounded-xl bg-surface-100/40 dark:bg-surface-800/40">
      <div class="flex items-center justify-center gap-1.5 text-brand-500 mb-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><line x1="12" y1="12" x2="12" y2="15"/></svg>
        <span class="font-bold text-base"><%= forks %></span>
      </div>
      <span class="text-xs text-surface-400 font-medium">Forks</span>
    </div>
    <div class="text-center p-3 rounded-xl bg-surface-100/40 dark:bg-surface-800/40">
      <div class="flex items-center justify-center gap-1.5 text-purple-500 mb-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        <span class="font-bold text-base"><%= watchers %></span>
      </div>
      <span class="text-xs text-surface-400 font-medium">Watchers</span>
    </div>
    <div class="text-center p-3 rounded-xl bg-surface-100/40 dark:bg-surface-800/40">
      <div class="flex items-center justify-center gap-1.5 text-emerald-500 mb-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span class="font-bold text-base"><%= issues %></span>
      </div>
      <span class="text-xs text-surface-400 font-medium">Open Issues</span>
    </div>
  </div>
</div>
