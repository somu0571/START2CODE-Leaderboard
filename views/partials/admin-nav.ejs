<div class="border-b border-surface-200 dark:border-surface-800 bg-surface-100/50 dark:bg-surface-900/40 backdrop-blur-md mb-8">
  <div class="container-narrow py-3">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
          Admin Portal
        </span>
        <span class="text-xs text-surface-400">&bull;</span>
        <span class="text-xs text-surface-500 dark:text-surface-400"><%= event.name %></span>
      </div>

      <div class="flex items-center gap-2 text-sm">
        <a href="/admin/export/contributors" class="btn-ghost text-xs px-2.5 py-1.5 flex items-center gap-1.5" title="Export Contributors as CSV">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export Contributors
        </a>
        <a href="/admin/export/contributions" class="btn-ghost text-xs px-2.5 py-1.5 flex items-center gap-1.5" title="Export Contributions as CSV">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export Contributions
        </a>
        <button id="admin-logout-btn" class="btn-ghost text-xs text-rose-500 hover:text-rose-600 px-2.5 py-1.5 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign Out
        </button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-1 mt-3 overflow-x-auto pb-1 text-sm border-t border-surface-200/60 dark:border-surface-800/60 pt-2">
      <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg font-medium transition-colors <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'bg-brand-600 text-white' : 'text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-800' %>">
        Dashboard
      </a>
      <a href="/admin/contributors" class="px-3 py-1.5 rounded-lg font-medium transition-colors <%= typeof activeTab !== 'undefined' && activeTab === 'contributors' ? 'bg-brand-600 text-white' : 'text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-800' %>">
        Contributors
      </a>
      <a href="/admin/contributions" class="px-3 py-1.5 rounded-lg font-medium transition-colors <%= typeof activeTab !== 'undefined' && activeTab === 'contributions' ? 'bg-brand-600 text-white' : 'text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-800' %>">
        Contributions
      </a>
      <a href="/admin/point-rules" class="px-3 py-1.5 rounded-lg font-medium transition-colors <%= typeof activeTab !== 'undefined' && activeTab === 'rules' ? 'bg-brand-600 text-white' : 'text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-800' %>">
        Point Rules
      </a>
      <a href="/admin/webhook-events" class="px-3 py-1.5 rounded-lg font-medium transition-colors <%= typeof activeTab !== 'undefined' && activeTab === 'webhooks' ? 'bg-brand-600 text-white' : 'text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-800' %>">
        Webhook Events
      </a>
      <a href="/admin/audit-logs" class="px-3 py-1.5 rounded-lg font-medium transition-colors <%= typeof activeTab !== 'undefined' && activeTab === 'audit' ? 'bg-brand-600 text-white' : 'text-surface-600 dark:text-surface-300 hover:bg-surface-200 dark:hover:bg-surface-800' %>">
        Audit Logs
      </a>
    </div>
  </div>
</div>
