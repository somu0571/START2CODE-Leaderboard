<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'START2CODE - Live leaderboard for the Start2Code Open Source Contribution Marathon by GitHub Club, Technova, SSCSE, Sharda University' %>">
  <title><%= typeof title !== 'undefined' ? title : 'START2CODE' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-surface-50 dark:bg-surface-950 text-surface-900 dark:text-surface-100 min-h-screen flex flex-col transition-colors duration-300">
  <nav class="sticky top-0 z-50 bg-white/80 dark:bg-surface-900/80 backdrop-blur-xl border-b border-surface-200 dark:border-surface-800">
    <div class="container-narrow">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 font-bold text-lg">
          <svg class="w-7 h-7 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span class="gradient-text">START2CODE</span>
        </a>

        <div class="hidden md:flex items-center gap-1">
          <a href="/" class="nav-link px-3 py-2">Home</a>
          <a href="/contributors" class="nav-link px-3 py-2">Leaderboard</a>
          <a href="/scoring" class="nav-link px-3 py-2">Scoring</a>
          <a href="/project" class="nav-link px-3 py-2">Project</a>
          <a href="/about" class="nav-link px-3 py-2">About</a>
        </div>

        <div class="flex items-center gap-2">
          <button id="theme-toggle" class="btn-ghost p-2 rounded-lg" aria-label="Toggle theme">
            <svg id="theme-icon-dark" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg id="theme-icon-light" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </button>

          <button id="mobile-menu-btn" class="md:hidden btn-ghost p-2" aria-label="Menu">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-surface-200 dark:border-surface-700 mt-2 pt-2">
        <a href="/" class="block px-3 py-2 nav-link">Home</a>
        <a href="/contributors" class="block px-3 py-2 nav-link">Leaderboard</a>
        <a href="/scoring" class="block px-3 py-2 nav-link">Scoring</a>
        <a href="/project" class="block px-3 py-2 nav-link">Project</a>
        <a href="/about" class="block px-3 py-2 nav-link">About</a>
      </div>
    </div>
  </nav>
