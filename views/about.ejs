<%- include('partials/header') %>

<main class="flex-1">
  <section class="py-12">
    <div class="container-narrow max-w-4xl">
      <h1 class="section-title mb-8">About the Event</h1>

      <div class="glass-card p-8 mb-8">
        <h2 class="text-2xl font-bold gradient-text mb-2"><%= event.fullName %></h2>
        <p class="text-lg text-surface-600 dark:text-surface-300 mb-6"><%= event.tagline %></p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-surface-400 text-sm uppercase tracking-wider mb-2">Organized By</h3>
            <p class="font-semibold text-surface-900 dark:text-white"><%= event.club %></p>
            <p class="text-sm text-surface-500"><%= event.society %></p>
            <p class="text-sm text-surface-500"><%= event.institution %></p>
          </div>
          <div>
            <h3 class="font-semibold text-surface-400 text-sm uppercase tracking-wider mb-2">Event Details</h3>
            <div class="space-y-1 text-sm text-surface-600 dark:text-surface-300">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                19 Sep &ndash; 27 Sep 2026
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= event.mode %>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <%= event.duration %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="glass-card p-8 mb-8">
        <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Event Leads</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% event.leads.forEach(function(lead) { %>
          <div class="flex items-center gap-3 p-4 rounded-xl bg-surface-50 dark:bg-surface-800/50">
            <div class="w-10 h-10 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-brand-600 dark:text-brand-400 font-bold"><%= lead.charAt(0) %></div>
            <span class="font-semibold text-surface-800 dark:text-surface-200"><%= lead %></span>
          </div>
          <% }); %>
        </div>
      </div>

      <div class="glass-card p-8 mb-8">
        <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Event Description</h2>
        <div class="space-y-3 text-surface-600 dark:text-surface-300 leading-relaxed">
          <% event.description.forEach(function(p) { %>
          <p><%= p %></p>
          <% }); %>
        </div>
      </div>

      <div class="glass-card p-8 mb-8">
        <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Schedule</h2>
        <div class="space-y-3">
          <% event.schedule.forEach(function(item) { %>
          <div class="flex items-center gap-4 p-3 rounded-lg hover:bg-surface-50 dark:hover:bg-surface-800/50 transition-colors">
            <span class="badge <%= item.type === 'marathon' ? 'badge-brand' : item.type === 'closing' ? 'badge-success' : 'badge-neutral' %> w-20 justify-center flex-shrink-0"><%= item.day %></span>
            <span class="text-surface-700 dark:text-surface-300 font-medium text-sm"><%= item.title %></span>
          </div>
          <% }); %>
        </div>
      </div>

      <div class="glass-card p-8">
        <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Tools &amp; Prerequisites</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <h3 class="font-semibold text-sm text-surface-400 uppercase tracking-wider mb-2">Platform/Tools</h3>
            <div class="flex flex-wrap gap-2">
              <% event.tools.forEach(function(tool) { %>
              <span class="badge-neutral"><%= tool %></span>
              <% }); %>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-sm text-surface-400 uppercase tracking-wider mb-2">Prerequisites</h3>
            <p class="text-sm text-surface-600 dark:text-surface-300"><%= event.prerequisites %></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
